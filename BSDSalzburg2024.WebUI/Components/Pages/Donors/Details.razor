@page "/donors/{Id}"
@rendermode @(new InteractiveWebAssemblyRenderMode(prerender: false))

@using BSDSalzburg2024.Application.Requests.Donors
@using BSDSalzburg2024.WebUI.Components.Display

@inject IMediator mediator

<PageTitle>Title</PageTitle>

<section class="section">
    <div class="level">
        <div class="level-left">
            <div class="level-item">
                <div>
                    <h1 class="title">
                        Title
                    </h1>
                    @if (this.personalData is not null)
                    {
                        <h2 class="subtitle">
                            @(this.personalData.FamilyName) @(this.personalData.GivenName)
                        </h2>
                    }
                </div>
            </div>
        </div>
        <div class="level-right">
            <div class="level-item">
                <div class="notification">
                    <strong>
                        AB
                    </strong>
                </div>
            </div>
            <div class="level-item">
                <div class="notification">
                    <strong>
                        Rh+
                    </strong>
                </div>
            </div>
        </div>
    </div>
</section>
<section>
    @if (!this.loadingActive)
    {
        <section class="section fixed-grid has-6-cols">
            <div class="grid">
                <div class="cell is-col-span-4 card">
                    <div class="card-header">
                        <p class="card-header-title">Personal</p>
                        <button class="card-header-icon" @onclick="() => { this.updatePersonalActive = true; }">
                            <span class="icon">
                                <i class="fas fa-pencil"></i>
                            </span>
                        </button>
                    </div>
                    <div class="card-content">
                        <div class="content">
                            <div class="fixed-grid">
                                <div class="grid">
                                    @if (this.personalData is not null)
                                    {
                                        <div class="cell">
                                            <p class="title is-6">FamilyName</p>
                                            <p class="subtitle is-6">@this.personalData.FamilyName</p>
                                        </div>
                                        <div class="cell">
                                            <p class="title is-6">GivenName</p>
                                            <p class="subtitle is-6">@this.personalData.GivenName</p>
                                        </div>
                                        <div class="cell is-col-span-2">
                                            <br />
                                        </div>
                                        <div class="cell">
                                            <p class="title is-6">DateOfBirth</p>
                                            <p class="subtitle is-6">@this.personalData.DateOfBirth?.ToString("d MMMM yyyy", System.Globalization.CultureInfo.CurrentCulture)</p>
                                        </div>
                                        <div class="cell">
                                            <p class="title is-6">Sex</p>
                                            <p class="subtitle is-6">
                                                @if (this.personalData.Sex is not null)
                                                {
                                                    <SexDisplay Model="this.personalData.Sex" />
                                                }
                                            </p>
                                        </div>
                                        <div class="cell is-col-span-2">
                                            <br />
                                        </div>
                                        <div class="cell">
                                            <p class="title is-6">...</p>
                                            <p class="subtitle is-6">...</p>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="cell is-col-span-2 card">
                    <div class="card-header">
                        <p class="card-header-title">Contact</p>
                        <button class="card-header-icon">
                            <span class="icon">
                                <i class="fas fa-pencil"></i>
                            </span>
                        </button>
                    </div>
                    <div class="card-content">
                        <p class="title is-6">Phone (private)</p>
                        <p class="subtitle is-6">+48 662 663 597</p>
                        <br />
                        <p class="title is-6">Phone (business)</p>
                        <p class="subtitle is-6">+48 662 663 597</p>
                        <hr />
                        <p class="title is-6">Email</p>
                        <p class="subtitle is-6">pmatusek@protonmail.com</p>
                        <hr />
                        <p class="title is-6">...</p>
                        <p class="subtitle is-6">...</p>
                    </div>
                </div>
                <div class="cell is-col-span-3 message is-warning">
                    <div class="message-body">
                        <p>Warning</p>
                    </div>
                </div>
                <div class="cell is-col-span-3 message is-success">
                    <div class="message-body">
                        <p>Information</p>
                    </div>
                </div>
                <div class="cell is-col-span-6 panel">
                    <p class="panel-tabs">
                        <a class="is-active">
                            Donations
                        </a>
                        <a>
                            Impediments
                        </a>
                        <a>
                            Laboratory results
                        </a>
                        <a>
                            Previous illnesses
                        </a>
                    </p>
                    <a class="panel-block">
                        Donation 1
                    </a>
                    <a class="panel-block">
                        Donation 2
                    </a>
                    <a class="panel-block">
                        Donation 3
                    </a>
                </div>
            </div>
        </section>
    }
</section>
<div class="modal @(this.updatePersonalActive ? "is-active" : "")">
    <div class="modal-background"></div>
    @if (this.updatePersonalActive)
    {
        Action<bool> callback = async (active) =>
        {
            this.updatePersonalActive = active;
            await this.Load();
        };
        <UpdatePersonal ActiveChanged="@callback" Id="@this.id" />
    }
</div>
<div class="modal @(this.loadingActive ? "is-active" : "")">
    <div class="modal-background"></div>
    <div class="modal-content">
        <section class="hero is-info">
            <div class="hero-body">
                <p class="title">LoadingData</p>
                <p class="subtitle">PleaseWait</p>
            </div>
        </section>
    </div>
</div>

@code {
    [Parameter]
    public string Id
    {
        get => this.id.ToString();
        set
        {
            this.id = int.Parse(value);
        }
    }

    private int id;
    private bool loadingActive = false;
    private bool updatePersonalActive = false;

    private GetDonorPersonalQuery personalCommand;

    private GetDonorPersonalQueryResultItem personalData;

    private async Task Load()
    {
        this.loadingActive = true;
        this.StateHasChanged();

        var result = await this.mediator.Send(personalCommand);
        this.personalData = result.Item;

        this.loadingActive = false;
        this.StateHasChanged();
    }

    protected override async Task OnInitializedAsync()
    {
        this.personalCommand = new GetDonorPersonalQuery(this.id);

        await this.Load();
        await base.OnInitializedAsync();
    }
}
