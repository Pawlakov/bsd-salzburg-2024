@using BSDSalzburg2024.Application.Requests.Donors
@using BSDSalzburg2024.Application.Requests.Models
@using BSDSalzburg2024.WebUI.Components.Display
@using BSDSalzburg2024.WebUI.Components.Validation
@using FluentValidation

@inject IMediator mediator

<EditForm @ref="this.form" Model="this.command" OnValidSubmit="this.Submit" FormName="DonorUpdatePersonalForm">
    <FluentValidationValidator @ref="this.validator" TModel="UpdateDonorPersonalCommand" />
    <div class="modal-card">
        <header class="modal-card-head">
            <p class="modal-card-title">Title</p>
            <button class="delete" aria-label="close" @onclick="() => this.ActiveChanged.InvokeAsync(false)"></button>
        </header>
        <section class="modal-card-body">
            <div class="field">
                <label class="label">Id</label>
                <TemplatedValidationMessage For="() => this.command.Id" BaseClass="input" Localizer="this.localizer">
                    <InputTemplate Context="inputClasses">
                        <input type="number" class="@inputClasses" value="@this.Id" disabled />
                    </InputTemplate>
                </TemplatedValidationMessage>
            </div>
            <div class="field">
                <label class="label">FamilyName</label>
                <TemplatedValidationMessage For="() => this.command.FamilyName" BaseClass="input" Localizer="this.localizer">
                    <InputTemplate Context="inputClasses">
                        <InputText class="@(inputClasses)" @bind-Value="this.command.FamilyName" />
                    </InputTemplate>
                </TemplatedValidationMessage>
            </div>
            <div class="field">
                <label class="label">GivenName</label>
                <TemplatedValidationMessage For="() => this.command.GivenName" BaseClass="input" Localizer="this.localizer">
                    <InputTemplate Context="inputClasses">
                        <InputText class="@(inputClasses)" @bind-Value="this.command.GivenName" />
                    </InputTemplate>
                </TemplatedValidationMessage>
            </div>
            <div class="field">
                <label class="label">DateOfBirth</label>
                <TemplatedValidationMessage For="() => this.command.DateOfBirth" BaseClass="input" Localizer="this.localizer">
                    <InputTemplate Context="inputClasses">
                        <InputDate class="@(inputClasses)" @bind-Value="this.command.DateOfBirth" />
                    </InputTemplate>
                </TemplatedValidationMessage>
            </div>
            <div class="field">
                <label class="label">Sex</label>
                <TemplatedValidationMessage For="() => this.command.Sex" BaseClass="select" Localizer="this.localizer">
                    <InputTemplate Context="inputClasses">
                        <div class="@(inputClasses)">
                            <InputSelect @bind-Value="this.command.Sex">
                                <option value=""></option>
                                @foreach (var sex in Sex.Options)
                                {
                                    <option value="@sex.Character.ToString()">
                                        <SexDisplay Model="sex" />
                                    </option>
                                }
                            </InputSelect>
                        </div>
                    </InputTemplate>
                </TemplatedValidationMessage>
            </div>
        </section>
        <footer class="modal-card-foot">
            <div class="buttons">
                <button class="button is-success" type="submit">Submit</button>
                <button class="button" type="reset" @onclick="() => this.Refresh()">Refresh</button>
            </div>
        </footer>
    </div>
</EditForm>

@code {
    private GetDonorPersonalQuery query;
    private UpdateDonorPersonalCommand command;
    private EditForm form;
    private FluentValidationValidator<UpdateDonorPersonalCommand> validator;

    [Parameter]
    public EventCallback<bool> ActiveChanged { get; set; }

    [Parameter]
    public int Id { get; set; }

    protected override async Task OnInitializedAsync()
    {
        this.query = new GetDonorPersonalQuery(this.Id);
        await this.Refresh();

        await base.OnInitializedAsync();
    }

    private async Task Refresh()
    {
        this.command = new UpdateDonorPersonalCommand(this.Id);

        var result = await this.mediator.Send(this.query);
        if (result.Item != null)
        {
            this.command.FamilyName = result.Item.FamilyName;
            this.command.GivenName = result.Item.GivenName;
            this.command.DateOfBirth = result.Item.DateOfBirth;
            this.command.Sex = result.Item.Sex?.Character.ToString();
        }
    }

    private async Task Submit()
    {
        var valid = this.form.EditContext.Validate();
        if (valid)
        {
            try
            {
                await this.mediator.Send(this.command);
                await this.ActiveChanged.InvokeAsync(false);
            }
            catch (ValidationException exception)
            {
                this.validator.PopulateErrors(exception.Errors);
            }
        }
    }
}
