@using System.Security.Claims
@using BSDSalzburg2024.Auth

@inject MyAuthenticationStateProvider AuthProvider

<AuthorizeView>
    <Authorized Context="auth">
        @(auth.User.Identity?.Name) (@(auth.User.Claims.Single(x => x.Type == ClaimTypes.Role).Value))
    </Authorized>
    <NotAuthorized>
        Anonymous
    </NotAuthorized>
</AuthorizeView>
<div class="dropdown is-hoverable is-right">
    <div class="dropdown-trigger">
        <button class="button" aria-haspopup="true" aria-controls="dropdown-menu">
            <span class="icon is-small">
                <i class="fas fa-angle-down" aria-hidden="true"></i>
            </span>
        </button>
    </div>
    <div class="dropdown-menu" id="dropdown-menu" role="menu">
        <div class="dropdown-content">
            <MyAuthorizeView Roles="User">
                <SimpleAuthorized>
                    <a href="javascript:void(0)" class="dropdown-item" @onclick="this.OpenOverrideModal">Override</a>
                </SimpleAuthorized>
            </MyAuthorizeView>
            <MyAuthorizeView>
                <SimpleAuthorized>
                    <a href="javascript:void(0)" class="dropdown-item" @onclick="this.Logout">Logout</a>
                </SimpleAuthorized>
                <OverrideAuthorized>
                    <a href="javascript:void(0)" class="dropdown-item" @onclick="this.OverrideLogout">Logout</a>
                </OverrideAuthorized>
                <NotAuthorized>
                    <a href="javascript:void(0)" class="dropdown-item" @onclick="this.OpenLoginModal">Login</a>
                </NotAuthorized>
            </MyAuthorizeView>
        </div>
    </div>
</div>
@if (this.showAuthModal)
{
    <div class="modal is-active">
        <div class="modal-background"></div>
        <div class="modal-card">
            <header class="modal-card-head">
                <p class="modal-card-title">Login</p>
                <button class="delete" aria-label="close" @onclick="this.CloseLoginModal"></button>
            </header>
            <section class="modal-card-body">
                <!-- Content ... -->
            </section>
            <footer class="modal-card-foot">
                <div class="buttons">
                    <button class="button is-success" @onclick="this.LoginUser">As User</button>
                    <button class="button is-success" @onclick="this.LoginAdmin">As Admin</button>
                    <button class="button" @onclick="this.CloseLoginModal">Cancel</button>
                </div>
            </footer>
        </div>
    </div>
}
@if (this.showOverrideModal)
{
    <div class="modal is-active">
        <div class="modal-background"></div>
        <div class="modal-card">
            <header class="modal-card-head">
                <p class="modal-card-title">Override</p>
                <button class="delete" aria-label="close" @onclick="this.CloseOverrideModal"></button>
            </header>
            <section class="modal-card-body">
                <!-- Content ... -->
            </section>
            <footer class="modal-card-foot">
                <div class="buttons">
                    <button class="button is-success" @onclick="this.AdminOverride">As Admin</button>
                    <button class="button" @onclick="this.CloseOverrideModal">Cancel</button>
                </div>
            </footer>
        </div>
    </div>
}

@code {
    private bool showAuthModal;
    private bool showOverrideModal;

    private async Task Logout()
    {
        await this.AuthProvider.SignOut();
    }

    private async Task OverrideLogout()
    {
        await this.AuthProvider.OverrideSignOut();
    }

    private async Task LoginAdmin()
    {
        await this.AuthProvider.SignIn("AdminUser", "Admin");
        this.CloseLoginModal();
    }

    private async Task LoginUser()
    {
        await this.AuthProvider.SignIn("NormalUser", "User");
        this.CloseLoginModal();
    }

    private async Task AdminOverride()
    {
        await this.AuthProvider.OverrideSignIn("AdminUser", "Admin");
        this.CloseOverrideModal();
    }

    private void OpenLoginModal()
    {
        this.showAuthModal = true;
    }

    private void CloseLoginModal()
    {
        this.showAuthModal = false;
    }

    private void OpenOverrideModal()
    {
        this.showOverrideModal = true;
    }

    private void CloseOverrideModal()
    {
        this.showOverrideModal = false;
    }
}